{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/7mlabs-workspace/sdk-numerology/request.schema.json",
  "title": "7mlabs Numerology request with optional payload extensions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation"
  ],
  "properties": {
    "operation": {
      "enum": [
        "profile",
        "name",
        "birth",
        "cycles",
        "essence",
        "names"
      ]
    },
    "system": {
      "const": "pythagorean",
      "default": "pythagorean"
    },
    "name": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "given"
      ],
      "properties": {
        "given": {
          "type": "string",
          "maxLength": 1024
        },
        "middle": {
          "type": "string",
          "maxLength": 1024
        },
        "family": {
          "type": "string",
          "maxLength": 1024
        }
      }
    },
    "birthDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "referenceDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "keepMasterNumbers": {
          "type": "boolean",
          "default": true
        },
        "yRule": {
          "enum": [
            "contextual",
            "vowel",
            "consonant"
          ],
          "default": "contextual"
        }
      }
    },
    "startAge": {
      "type": "integer",
      "minimum": 0,
      "maximum": 120,
      "default": 0
    },
    "years": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120,
      "default": 100
    },
    "extensions": {
      "description": "Omit or use null for the unchanged schema 1.0 result. An object opts into schema 1.1 additions.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reducedValues": {
              "type": "boolean",
              "default": true
            },
            "indicators": {
              "type": "boolean",
              "default": true
            },
            "currentName": {
              "anyOf": [
                {
                  "$ref": "#/properties/name"
                },
                {
                  "type": "null"
                }
              ]
            },
            "nameSet": {
              "anyOf": [
                {
                  "$ref": "#/$defs/profileNameSet"
                },
                {
                  "type": "null"
                }
              ]
            },
            "nameChallenges": {
              "anyOf": [
                {
                  "$ref": "#/$defs/nameChallengeOptions"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      ]
    },
    "names": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/nameInput"
      }
    },
    "combinations": {
      "type": "array",
      "maxItems": 32,
      "default": [],
      "items": {
        "$ref": "#/$defs/nameCombination"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "profile",
              "name",
              "essence"
            ]
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "required": [
          "name"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "profile",
              "birth",
              "cycles",
              "essence"
            ]
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "required": [
          "birthDate"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "profile",
              "cycles"
            ]
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "required": [
          "referenceDate"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "extensions": {
            "type": "object",
            "required": [
              "currentName"
            ],
            "properties": {
              "currentName": {
                "type": "object"
              }
            }
          }
        },
        "required": [
          "extensions"
        ]
      },
      "then": {
        "properties": {
          "operation": {
            "enum": [
              "name",
              "profile"
            ]
          },
          "extensions": {
            "properties": {
              "indicators": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "names"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "required": [
          "names"
        ],
        "properties": {
          "extensions": {
            "type": "null"
          },
          "name": false,
          "referenceDate": false,
          "startAge": {
            "const": 0
          },
          "years": {
            "const": 100
          }
        }
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "names"
              ]
            },
            {
              "required": [
                "combinations"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "extensions": {
            "type": "object",
            "required": [
              "nameSet"
            ],
            "properties": {
              "nameSet": {
                "type": "object"
              }
            }
          }
        },
        "required": [
          "extensions"
        ]
      },
      "then": {
        "properties": {
          "operation": {
            "const": "profile"
          },
          "extensions": {
            "properties": {
              "indicators": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "extensions"
        ],
        "properties": {
          "extensions": {
            "type": "object",
            "required": [
              "nameChallenges"
            ],
            "properties": {
              "nameChallenges": {
                "type": "object"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "operation": {
            "enum": [
              "name",
              "profile"
            ]
          },
          "extensions": {
            "properties": {
              "indicators": {
                "const": true
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "nameInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "$ref": "#/properties/name"
        }
      }
    },
    "nameSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nameId"
      ],
      "properties": {
        "nameId": {
          "$ref": "#/$defs/identifier"
        },
        "part": {
          "enum": [
            "full",
            "given",
            "middle",
            "family"
          ],
          "default": "full"
        }
      }
    },
    "nameCombination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sources"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "sources": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/nameSource"
          }
        }
      }
    },
    "profileNameSet": {
      "type": "object",
      "additionalProperties": false,
      "description": "The birth name is injected as reserved id birth; at most 31 additional names. IDs, selected-part overlap and normalized duplication are validated by the engine.",
      "properties": {
        "names": {
          "type": "array",
          "maxItems": 31,
          "default": [],
          "items": {
            "$ref": "#/$defs/nameInput"
          }
        },
        "combinations": {
          "type": "array",
          "maxItems": 32,
          "default": [],
          "items": {
            "$ref": "#/$defs/nameCombination"
          }
        }
      }
    },
    "nameChallengeOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nameOrder"
      ],
      "properties": {
        "nameOrder": {
          "enum": [
            "givenMiddleFamily",
            "familyMiddleGiven"
          ]
        }
      },
      "description": "Explicit first/last-letter order; soul zero retained, personality zero mapped to nine (Roy Kirkland)."
    }
  }
}
