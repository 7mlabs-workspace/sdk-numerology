{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/7mlabs-workspace/sdk-numerology/request.schema.json",
  "title": "7mlabs Numerology 1.0 request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation"
  ],
  "properties": {
    "operation": {
      "enum": [
        "profile",
        "name",
        "birth",
        "cycles",
        "essence"
      ]
    },
    "system": {
      "const": "pythagorean",
      "default": "pythagorean"
    },
    "name": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "given"
      ],
      "properties": {
        "given": {
          "type": "string",
          "maxLength": 1024
        },
        "middle": {
          "type": "string",
          "maxLength": 1024
        },
        "family": {
          "type": "string",
          "maxLength": 1024
        }
      }
    },
    "birthDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "referenceDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "keepMasterNumbers": {
          "type": "boolean",
          "default": true
        },
        "yRule": {
          "enum": [
            "contextual",
            "vowel",
            "consonant"
          ],
          "default": "contextual"
        }
      }
    },
    "startAge": {
      "type": "integer",
      "minimum": 0,
      "maximum": 120,
      "default": 0
    },
    "years": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120,
      "default": 100
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "profile",
              "name",
              "essence"
            ]
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "required": [
          "name"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "profile",
              "birth",
              "cycles",
              "essence"
            ]
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "required": [
          "birthDate"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "profile",
              "cycles"
            ]
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "required": [
          "referenceDate"
        ]
      }
    }
  ]
}
